<Project Sdk="Microsoft.NET.Sdk">

  <!-- WWC client plugin (BepInEx 5, SPT 4.1.6 / EFT 40743): the patches, wall flag and Slickster client code in one DLL.
       Built from the parts' own Plugin.cs files (linked, not copied) with WWC defined; each keeps its own BepInPlugin id and Harmony id,
       so their hooks, ordering (Patches runs after the Slickster on item creation) and logs are as before. Everything they read sits in
       BepInEx\plugins\WWC (patches\, shared\, wear_*.png, slickster.bundle, content-ready.json); settings come from the server mod's part folders.
       References the installed game's DLLs read-only (never copied). -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>WWC.Client</AssemblyName>
    <RootNamespace>WWC.Client</RootNamespace>
    <Version>1.2.0</Version>
    <DefineConstants>$(DefineConstants);WWC</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <SptRoot Condition="'$(SptRoot)' == ''">D:\SPT</SptRoot>
    <ManagedDirectory>$(SptRoot)\EscapeFromTarkov_Data\Managed</ManagedDirectory>
    <!-- The wall flag code was written with nullable off (it built for net472); its warnings are noise here. CS0618: obsolete game APIs it already used. -->
    <NoWarn>$(NoWarn);CS0618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8632</NoWarn>
  </PropertyGroup>

  <!-- Forge build (dotnet build -p:Forge=true): one BepInPlugin (ForgePlugin, com.mrpenguin5292.wwc) that starts the three parts, version 2.1.1.
       The default build keeps the three plugins and their old GUIDs for the installs other local mods depend on. -->
  <PropertyGroup Condition="'$(Forge)' == 'true'">
    <DefineConstants>$(DefineConstants);WWC_FORGE</DefineConstants>
    <Version>2.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDirectory)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(ManagedDirectory)\Comfort.dll" Private="false" />
    <Reference Include="CommonExtensions" HintPath="$(ManagedDirectory)\CommonExtensions.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(ManagedDirectory)\Sirenix.Serialization.dll" Private="false" />
    <Reference Include="DissonanceVoip" HintPath="$(ManagedDirectory)\DissonanceVoip.dll" Private="false" Condition="Exists('$(ManagedDirectory)\DissonanceVoip.dll')" />
    <Reference Include="ItemComponent.Types" HintPath="$(ManagedDirectory)\ItemComponent.Types.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDirectory)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDirectory)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDirectory)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDirectory)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDirectory)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDirectory)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDirectory)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SptRoot)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SptRoot)\BepInEx\core\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\JackalPatches\Client\*.cs" Link="Parts\Patches\%(Filename)%(Extension)" />
    <Compile Include="..\..\WallFlag\Client\*.cs" Link="Parts\Flags\%(Filename)%(Extension)" />
    <Compile Include="..\..\Slickster\Client\*.cs" Link="Parts\Slickster\%(Filename)%(Extension)" />
    <Compile Include="ForgePlugin.cs" />
    <Compile Include="ForgeSettings.cs" />
    <Compile Include="Jsonc.cs" />
  </ItemGroup>

  <!-- Forge build 2.1: the folded-in lines' client code. Each reads its files from BepInEx\plugins\WWC\<part> (ForgePlugin.PartAt).
       BigBrain (DrakiaXYZ) is a soft dependency of the RC bomb car: without it the car still works, bots only hear it. Its bot layer
       (RCBombCar\Client\BotLayer.cs, the only file naming BigBrain types) is built into WWC.BigBrain.dll (..\BigBrain), not into this DLL. -->
  <ItemGroup Condition="'$(Forge)' == 'true'">
    <Reference Include="Comfort.Unity" HintPath="$(ManagedDirectory)\Comfort.Unity.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(ManagedDirectory)\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ManagedDirectory)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDirectory)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ManagedDirectory)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDirectory)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDirectory)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(Forge)' == 'true'">
    <Compile Include="..\..\WWCMags\Client\*.cs" Link="Parts\Mags\%(Filename)%(Extension)" />
    <Compile Include="..\..\WWCWraps\Client\*.cs" Link="Parts\Wraps\%(Filename)%(Extension)" />
    <Compile Include="..\..\JackalArmbands\Client\*.cs" Link="Parts\Armbands\%(Filename)%(Extension)" />
    <Compile Include="..\..\WWCGunDisplays\Client\*.cs" Link="Parts\GunDisplays\%(Filename)%(Extension)" />
    <Compile Include="..\..\WWCHelmetDisplays\Client\*.cs" Link="Parts\HelmetDisplays\%(Filename)%(Extension)" />
    <Compile Include="..\..\JackalGunCase\Client\*.cs" Link="Parts\GunCase\%(Filename)%(Extension)" />
    <Compile Include="..\..\JackalPatchCase\Client\*.cs" Link="Parts\PatchCase\%(Filename)%(Extension)" />
    <Compile Include="..\..\FTHS\Client\*.cs" Link="Parts\FTHS\%(Filename)%(Extension)" />
    <Compile Include="..\..\USMCPC\Client\*.cs" Link="Parts\USMCPC\%(Filename)%(Extension)" />
    <Compile Include="..\..\JPC\Client\*.cs" Link="Parts\JPC\%(Filename)%(Extension)" />
    <Compile Include="..\..\Airlite\Client\*.cs" Link="Parts\AirLite\%(Filename)%(Extension)" />
    <Compile Include="..\..\AvonMask\Client\*.cs" Link="Parts\AvonMask\%(Filename)%(Extension)" />
    <Compile Include="..\..\Grunts\Client\*.cs" Link="Parts\Grunts\%(Filename)%(Extension)" />
    <Compile Include="..\..\ZynTin\Client\*.cs" Link="Parts\ZynTin\%(Filename)%(Extension)" />
    <Compile Include="..\..\Vape\Client\*.cs" Link="Parts\Vape\%(Filename)%(Extension)" />
    <Compile Include="..\..\RCBombCar\Client\*.cs" Exclude="..\..\RCBombCar\Client\BotLayer.cs" Link="Parts\RCBombCar\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
